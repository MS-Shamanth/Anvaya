# ─────────────────────────────────────────────────────────────
# Shared
# ─────────────────────────────────────────────────────────────
# Signs the session cookie. Required in any hosted environment.
# Generate one: openssl rand -base64 32   (or) node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be at least 32 characters. Set this in Vercel → Project → Settings → Environment Variables.
SESSION_SECRET=change-this-to-a-random-secret-min-32-chars

# ─────────────────────────────────────────────────────────────
# Local Express server (server/src) — only used by `npm run server`
# The Vercel deployment uses the serverless functions in api/ instead.
# ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# Future: replace the in-code user directory with a real database
# ─────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/anvaya
# Shared rate-limit store so throttling is global rather than per instance
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
