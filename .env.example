# Server Configuration
PORT=3001
NODE_ENV=development

# Session Secret (MUST be changed in production - generate with: openssl rand -base64 32)
SESSION_SECRET=change-this-to-a-random-secret-in-production-min-32-chars

# CORS Settings
FRONTEND_URL=http://localhost:5173

# Database (for future use when migrating from in-memory)
# DATABASE_URL=postgresql://user:password@localhost:5432/anvaya

# Redis (optional - for production session storage)
# REDIS_URL=redis://localhost:6379
